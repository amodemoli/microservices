{
    // add yours...
    "services": {
        // services host http address
        "user": "http://localhost:8081",
        "auth": "http://localhost:8082",
        "admin": "http://localhost:8083",
        "notification": "http://localhost:8084"
    },

    // proxy middlewares settings
    "middlewares": {
        // limiter cleanup ticker time in minutes,
        // e.g: 1 mean's limiter cleans limit requests in 1 minute
        "limiter_cleanup_ticker": 1
    },

    // general proxy settings
    "general": {
         // pinger helper function named "Ping" timeout in seconds.
        "pinging_timeout": "5s"
    }
}